# Local development only. Set your own credentials and a random session secret.
DATABASE_URL=postgres://mystore:local-dev-only@localhost:5432/mystore
DATABASE_URL_CONTAINER=postgres://mystore:local-dev-only@db:5432/mystore
TEST_DATABASE_URL=postgres://mystore:local-dev-only@localhost:5432/mystore_test
POSTGRES_PASSWORD=local-dev-only
SESSION_SECRET=
PORT=3001
NODE_ENV=development
WEB_ORIGINS=http://localhost:5173,http://localhost:3001
# Optional photo recognition; server-only key. Manual receiving works without it.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Optional email delivery. Configure the API and a separate email worker.
EMAIL_ENABLED=false
PUBLIC_BASE_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TOKEN_ENCRYPTION_KEY=
